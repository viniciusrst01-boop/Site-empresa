{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/backups",
      "schedule": "0 3 * * *"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/login.css",
      "dest": "/public/login.css"
    },
    {
      "src": "/styles.css",
      "dest": "/public/styles.css"
    },
    {
      "src": "/app.js",
      "dest": "/public/app.js"
    },
    {
      "src": "/nc-tv.css",
      "dest": "/public/nc-tv.css"
    },
    {
      "src": "/nc-tv.js",
      "dest": "/public/nc-tv.js"
    },
    {
      "src": "/vendor/(.*)",
      "dest": "/public/vendor/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
